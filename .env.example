# Supabase — the journal reads from here.
# Copy this file to `.env.local` and fill in the real values.
# In Lovable: Project → Settings → Environment variables.

# Both must be present in the BUILD environment: Vite inlines VITE_* vars
# at build time, so setting them only at runtime on the host has no effect —
# the journal will render empty because the client has no endpoint to call.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# src/lib/supabase.ts accepts any of these three names for the publishable
# (anon) key; this is the canonical one.
VITE_SUPABASE_PUBLISHABLE_DEFAULT_KEY=YOUR-ANON-KEY
# Aliases also accepted: VITE_SUPABASE_ANON_KEY, VITE_SUPABASE_PUBLISHABLE_KEY

# --- Lead capture (agency Supabase, shared multi-tenant leads table) ---
# anon/publishable key is public-safe: the leads table is insert-only under RLS.
VITE_LEADS_SUPABASE_URL=https://tfgkbxrxzmjexnuwwhcj.supabase.co
VITE_LEADS_SUPABASE_ANON_KEY=<agency-anon-publishable-key>
VITE_CLIENT_SLUG=kova
# Google Sheet fallback/live destination (Apps Script web app, no-cors POST).
VITE_LEADS_SHEET_URL=https://script.google.com/macros/s/XXXX/exec
VITE_LEADS_SHEET_TOKEN=<shared secret matching the Apps Script SECRET>
