# ----------------------------------------------------------------
# Kova Sun Shade — Apache config for the production bundle.
#
# This file ships inside `dist/` after `npm run build`, so dropping
# the whole dist into the web root is enough — no separate server
# config edits required.
#
# Canonicalization (added — fixes SEMrush "hreflang points to a
# 301" errors): the frontend's <link rel="alternate" hreflang="…">
# and sitemap.xml always use https://kovasunshade.com + a path with
# NO trailing slash (except "/"). The rules below make the server
# agree with that:
#   1. www.kovasunshade.com -> kovasunshade.com (non-www is canonical)
#   2. /page/ -> /page (one 301, trailing slash stripped)
#   3. /page (no slash) is served directly, with no redirect at all —
#      this is the important part. Apache's default DirectorySlash
#      behavior would otherwise 301 /page to /page/ on its own,
#      fighting the rule above and producing exactly the redirect
#      loop SEMrush flagged. DirectorySlash Off + MultiViews off
#      (below) disable that.
# ----------------------------------------------------------------

Options -Indexes -MultiViews
DirectorySlash Off

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # --- One canonical host: https:// without www ---
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://kovasunshade.com%{REQUEST_URI} [R=301,L]

  # --- /page/ -> /page (matches the URLs in sitemap.xml and hreflang tags) ---
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^(.+)/$ /$1 [R=301,L]

  # --- Serve the pre-rendered page for /page without any redirect ---
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^(.+[^/])$ /$1/index.html [L]

  # --- If the request is an actual file or directory, serve it ---
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # --- Otherwise hand control to index.html so React Router can route ---
  # (client renders the NotFound page; ErrorDocument 404 below keeps the
  # real 404 status code so this doesn't count as a soft-404)
  RewriteRule ^ index.html [L]
</IfModule>

# --- Compression -------------------------------------------------
# Mostly redundant with the gzip-pre-compressed bundles Vite emits,
# but covers anything served raw (HTML, sitemaps, manifest, etc.).
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE application/xml image/svg+xml
  AddOutputFilterByType DEFLATE application/manifest+json
</IfModule>

# --- Cache headers -----------------------------------------------
# Vite's hashed asset filenames are immutable; cache aggressively.
# index.html / robots.txt / sitemap.xml / llms.txt change with every
# deploy, so cache them only briefly so users see updates fast.
<IfModule mod_expires.c>
  ExpiresActive On

  # Hashed assets — forever.
  ExpiresByType image/webp           "access plus 1 year"
  ExpiresByType image/jpeg           "access plus 1 year"
  ExpiresByType image/png            "access plus 1 year"
  ExpiresByType image/svg+xml        "access plus 1 year"
  ExpiresByType image/x-icon         "access plus 1 year"
  ExpiresByType video/mp4            "access plus 1 year"
  ExpiresByType font/woff2           "access plus 1 year"
  ExpiresByType text/css             "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"

  # Rotates per deploy — cache for 5 minutes.
  ExpiresByType text/html            "access plus 5 minutes"
  ExpiresByType application/xml      "access plus 5 minutes"
  ExpiresByType text/plain           "access plus 5 minutes"
</IfModule>

<IfModule mod_headers.c>
  # Mark every immutable asset with the long-cache hint browsers respect.
  <FilesMatch "\.(webp|jpg|jpeg|png|svg|woff2|mp4|css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Short cache for the HTML shell + crawler files.
  <FilesMatch "\.(html|xml|txt)$">
    Header set Cache-Control "public, max-age=300, must-revalidate"
  </FilesMatch>

  # index.html specifically must NEVER be cached (overrides the FilesMatch
  # above — this block runs later so it wins). Every route is pre-rendered
  # to its own index.html (root, /roller/index.html, /bidai/jurnal/…), and
  # each one references whichever hashed /assets/*.js|css existed at build
  # time. A stale cached index.html after a deploy means the browser
  # requests JS/CSS files that no longer exist -> blank screen. Cache-
  # Control wins over Expires per RFC 7234, but we clear Expires too so
  # there's no ambiguity for older caches that only look at that header.
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Expires "0"
  </FilesMatch>

  # Long-term immutable caching for everything under /assets/, regardless
  # of extension (covers hashed fonts/images Vite emits there too).
  SetEnvIf Request_URI "^/assets/" IS_HASHED_ASSET
  Header set Cache-Control "public, max-age=31536000, immutable" env=IS_HASHED_ASSET

  # Security baseline.
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# --- MIME types for fonts + WebP --------------------------------
<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType font/woff2 .woff2
  AddType application/manifest+json .webmanifest
</IfModule>

# --- Custom error fallback --------------------------------------
ErrorDocument 404 /index.html

# php -- BEGIN cPanel-generated handler, do not edit
# Set the "ea-php82" package as the default "PHP" programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php82 .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit
